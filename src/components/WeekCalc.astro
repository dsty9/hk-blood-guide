---
// 孕周 / 预产期计算器：按末次月经推算，标出 NT、NIPT 等常规产检时间点
---
<div class="tool" id="weekcalc">
  <h2>孕周 · 预产期计算</h2>
  <p class="hint">输入末次月经第一天，算出当前孕周和常规产检时间点</p>
  <label for="lmp">末次月经第一天</label>
  <input type="date" id="lmp" />
  <button type="button" class="btn">立即计算 →</button>
  <div class="tool-out" aria-live="polite">
    <div class="now"></div>
    <ul></ul>
    <p class="fine">按 28 天月经周期推算，仅供参考；实际孕周以 B 超和医生判断为准。</p>
  </div>
</div>
<script is:inline>
(function () {
  var root = document.getElementById('weekcalc');
  var input = root.querySelector('input'), out = root.querySelector('.tool-out');
  var today = new Date(); today.setHours(0, 0, 0, 0);
  input.max = today.toISOString().slice(0, 10);
  var DAY = 864e5;
  var fmt = function (d) { return (d.getMonth() + 1) + '月' + d.getDate() + '日'; };
  var add = function (d, n) { return new Date(d.getTime() + n * DAY); };
  var steps = [
    [70, 'NIPT 产前筛查（孕 10 周起）'],
    [77, 'NT 颈项透明层检查（11–14 周）'],
    [140, '详细结构 B 超（20–22 周）'],
    [168, '妊娠糖尿病筛查（24–28 周）'],
    [280, '预产期（40 周）'],
  ];
  root.querySelector('button').addEventListener('click', function () {
    if (!input.value) { input.focus(); return; }
    var lmp = new Date(input.value + 'T00:00:00');
    var days = Math.round((today - lmp) / DAY);
    if (days < 0 || days > 300) { out.classList.add('on'); out.querySelector('.now').textContent = '请检查日期是否正确'; out.querySelector('ul').innerHTML = ''; return; }
    out.querySelector('.now').textContent = '当前约孕 ' + Math.floor(days / 7) + ' 周 ' + (days % 7) + ' 天';
    out.querySelector('ul').innerHTML = steps.map(function (s) {
      var d = add(lmp, s[0]), passed = days >= s[0];
      var when = s[0] === 280 ? fmt(d) : passed ? '已可安排' : fmt(d) + '起';
      return '<li class="' + (passed && s[0] < 280 ? 'ok' : '') + '"><span>' + s[1] + '</span><b>' + when + '</b></li>';
    }).join('');
    out.classList.add('on');
  });
})();
</script>
